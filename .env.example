# IEC62443 Assistant runtime configuration
# Copy this file to .env and adjust values as needed.

# Application metadata
APP_NAME=otcybersecurity-assistant
APP_VERSION=0.1.0

# Server binding
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS origins (comma-separated)
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Nan Builders API
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=your-url

# Model configuration
LLM_MODEL=your-model
LLM_MODEL_EMBEDDING=your-model

# ChromaDB configuration (HTTP server mode)
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=your-documents

# Retrieval configuration
TOP_K_DEFAULT=3
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MMR_FETCH_K=20
MMR_LAMBDA_MULT=0.7
ENABLE_HYBRID_SEARCH=true
SIMILARITY_THRESHOLD=0.70
RETRIEVER_SEARCH_TYPE=mmr

# Security
JWT_SECRET=change-me-in-production
API_KEY=sk-change-me
RATE_LIMIT=30/minute
